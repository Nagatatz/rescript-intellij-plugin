    <actions>
        <action id="ReScript.SwitchFile"
                class="com.rescript.plugin.navigation.RescriptSwitchFileAction"
                text="Switch .res/.resi"
                description="Switch between .res and .resi files">
            <keyboard-shortcut first-keystroke="alt O" keymap="$default"/>
            <add-to-group group-id="GoToMenu" anchor="last"/>
        </action>
        <action id="ReScript.CreateInterface"
                class="com.rescript.plugin.navigation.RescriptCreateInterfaceAction"
                text="Create Interface File"
                description="Generate .resi from current .res file">
            <add-to-group group-id="GoToMenu" anchor="last"/>
        </action>
        <action id="ReScript.GotoImplementation"
                class="com.rescript.plugin.navigation.RescriptGotoImplementationAction"
                text="Go to Implementation"
                description="Navigate from .resi interface to .res implementation">
            <keyboard-shortcut first-keystroke="control alt B" keymap="$default"/>
            <add-to-group group-id="GoToMenu" anchor="last"/>
        </action>
        <action id="ReScript.NewFile"
                class="com.rescript.plugin.template.RescriptCreateFileAction"
                text="ReScript File"
                description="Create a new ReScript file">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
        <action id="ReScript.OpenCompiledJs"
                class="com.rescript.plugin.navigation.RescriptOpenCompiledJsAction"
                text="Open Compiled JavaScript"
                description="Open compiled JS for this ReScript file">
            <add-to-group group-id="GoToMenu" anchor="last"/>
            <keyboard-shortcut first-keystroke="alt shift J" keymap="$default"/>
        </action>
        <action id="ReScript.PasteAsJsonT"
                class="com.rescript.plugin.paste.RescriptPasteAsJsonAction"
                text="Paste as JSON.t"
                description="Convert clipboard JSON to ReScript JSON.t">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="ReScript.DebugCompiledJs"
                class="com.rescript.plugin.debug.RescriptDebugCompiledJsAction"
                text="Debug Compiled JavaScript"
                description="Debug compiled JS for this ReScript file with Node.js">
            <add-to-group group-id="GoToMenu" anchor="last"/>
            <keyboard-shortcut first-keystroke="alt shift D" keymap="$default"/>
        </action>
        <!-- Code Generation (Cmd+N / Alt+Insert) -->
        <group id="ReScript.GenerateGroup"
               class="com.rescript.plugin.generate.RescriptGenerateGroup"
               text="ReScript"
               popup="true">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </group>
        <action id="ReScript.GenerateDtsBinding"
                class="com.rescript.plugin.binding.DtsGenerateBindingAction"
                text="Generate ReScript Binding"
                description="Generate ReScript binding from TypeScript .d.ts file">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
