<idea-plugin>
    <id>com.rescript.plugin</id>
    <name>ReScript</name>
    <vendor url="https://github.com/rescript-intellij-plugin">ReScript IntelliJ Plugin</vendor>

    <description><![CDATA[
        <h2>ReScript Language Support for IntelliJ IDEA</h2>
        <p>Full language support for <a href="https://rescript-lang.org">ReScript</a> (.res, .resi files).</p>

        <h3>Features</h3>
        <ul>
            <li>Syntax highlighting</li>
            <li>Code completion (via LSP)</li>
            <li>Go to definition (via LSP)</li>
            <li>Hover documentation (via LSP)</li>
            <li>Find references (via LSP)</li>
            <li>Diagnostics / error highlighting (via LSP)</li>
            <li>Inlay hints (via LSP)</li>
            <li>Code folding</li>
            <li>Brace matching</li>
            <li>Line and block comments</li>
        </ul>

        <h3>Requirements</h3>
        <ul>
            <li>Node.js installed and available in PATH</li>
            <li><code>@rescript/language-server</code> installed in project or globally</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.spellchecker</depends>
    <depends optional="true" config-file="rescript-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="rescript-js-injection.xml">JavaScript</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- File types -->
        <fileType name="ReScript"
                  extensions="res"
                  fieldName="INSTANCE"
                  language="ReScript"
                  implementationClass="com.rescript.plugin.RescriptFileType"/>
        <fileType name="ReScript Interface"
                  extensions="resi"
                  fieldName="INSTANCE"
                  language="ReScript"
                  implementationClass="com.rescript.plugin.RescriptInterfaceFileType"/>

        <!-- Parser -->
        <lang.parserDefinition language="ReScript"
                               implementationClass="com.rescript.plugin.lang.RescriptParserDefinition"/>

        <!-- Syntax highlighting -->
        <lang.syntaxHighlighterFactory language="ReScript"
                                       implementationClass="com.rescript.plugin.highlight.RescriptSyntaxHighlighterFactory"/>

        <!-- Brace matching -->
        <lang.braceMatcher language="ReScript"
                           implementationClass="com.rescript.plugin.highlight.RescriptBraceMatcher"/>

        <!-- Comments -->
        <lang.commenter language="ReScript"
                        implementationClass="com.rescript.plugin.commenter.RescriptCommenter"/>

        <!-- Code folding -->
        <lang.foldingBuilder language="ReScript"
                             implementationClass="com.rescript.plugin.folding.RescriptFoldingBuilder"/>

        <!-- Structure view -->
        <lang.psiStructureViewFactory language="ReScript"
                                      implementationClass="com.rescript.plugin.structure.RescriptStructureViewFactory"/>

        <!-- Color settings page -->
        <colorSettingsPage
                implementation="com.rescript.plugin.highlight.RescriptColorSettingsPage"/>

        <!-- Explicit colors for ReScript tokens (override theme defaults) -->
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/RescriptDarcula.xml"/>
        <additionalTextAttributes scheme="Dark" file="colorSchemes/RescriptDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/RescriptDefault.xml"/>
        <additionalTextAttributes scheme="Light" file="colorSchemes/RescriptDefault.xml"/>

        <!-- rescript.json icon -->
        <iconProvider
                implementation="com.rescript.plugin.config.RescriptJsonIconProvider"/>

        <!-- Run Configuration -->
        <configurationType
                implementation="com.rescript.plugin.run.RescriptRunConfigurationType"/>

        <!-- Console Filter (clickable file:line links in compiler output) -->
        <consoleFilterProvider
                implementation="com.rescript.plugin.run.RescriptConsoleFilterProvider"/>

        <!-- Code style settings -->
        <langCodeStyleSettingsProvider
                implementation="com.rescript.plugin.codestyle.RescriptCodeStyleSettingsProvider"/>

        <!-- Smart quote completion -->
        <lang.quoteHandler language="ReScript"
                           implementationClass="com.rescript.plugin.editor.RescriptQuoteHandler"/>

        <!-- Smart indentation on Enter -->
        <lineIndentProvider
                implementation="com.rescript.plugin.codestyle.RescriptLineIndentProvider"/>

        <!-- Breadcrumb navigation -->
        <breadcrumbsInfoProvider
                implementation="com.rescript.plugin.breadcrumb.RescriptBreadcrumbsProvider"/>

        <!-- Rename refactoring -->
        <renameHandler
                implementation="com.rescript.plugin.refactor.RescriptRenameHandler"/>
        <lang.namesValidator language="ReScript"
                             implementationClass="com.rescript.plugin.refactor.RescriptNamesValidator"/>

        <!-- Project settings -->
        <projectConfigurable
                parentId="language"
                instance="com.rescript.plugin.settings.RescriptConfigurable"
                id="com.rescript.plugin.settings"
                displayName="ReScript"/>
        <projectService
                serviceImplementation="com.rescript.plugin.settings.RescriptProjectSettings"/>

        <!-- LSP (completion, diagnostics, navigation, hover, etc.) -->
        <platform.lsp.serverSupportProvider
                implementation="com.rescript.plugin.lsp.RescriptLspServerSupportProvider"/>

        <!-- TODO indexer -->
        <todoIndexer filetype="ReScript"
                     implementationClass="com.rescript.plugin.indexing.RescriptTodoIndexer"/>
        <todoIndexer filetype="ReScript Interface"
                     implementationClass="com.rescript.plugin.indexing.RescriptTodoIndexer"/>

        <!-- Go to Symbol -->
        <gotoSymbolContributor
                implementation="com.rescript.plugin.navigation.RescriptSymbolContributor"/>

        <!-- Go to Related (.res/.resi/.js) -->
        <gotoRelatedProvider
                implementation="com.rescript.plugin.navigation.RescriptGotoRelatedProvider"/>

        <!-- Code formatting (rescript format CLI) -->
        <formattingService
                implementation="com.rescript.plugin.formatter.RescriptFormattingService"/>

        <!-- Live Templates -->
        <defaultLiveTemplates>/liveTemplates/ReScript</defaultLiveTemplates>

        <!-- Inspections -->
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptDuplicateOpen"
                         displayName="Duplicate open statement"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptDuplicateOpenInspection"/>
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptEmptyModule"
                         displayName="Empty module declaration"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptEmptyModuleInspection"/>
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptMissingConfig"
                         displayName="Missing rescript.json configuration"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptMissingConfigInspection"/>

        <!-- File Templates -->
        <internalFileTemplate name="ReScript Module"/>
        <internalFileTemplate name="ReScript Interface"/>
        <internalFileTemplate name="ReScript Component"/>

        <!-- Spell checking -->
        <spellchecker.support language="ReScript"
                              implementationClass="com.rescript.plugin.spellcheck.RescriptSpellcheckingStrategy"/>

        <!-- Postfix Completion -->
        <codeInsight.template.postfixTemplateProvider language="ReScript"
                                                      implementationClass="com.rescript.plugin.completion.RescriptPostfixTemplateProvider"/>

        <!-- Editor notification (LSP not found) -->
        <editorNotificationProvider
                implementation="com.rescript.plugin.editor.RescriptEditorNotificationProvider"/>

        <!-- AST factory for language injection support in string literals -->
        <lang.ast.factory language="ReScript"
                          implementationClass="com.rescript.plugin.lang.RescriptAstFactory"/>
    </extensions>

    <actions>
        <action id="ReScript.SwitchFile"
                class="com.rescript.plugin.navigation.RescriptSwitchFileAction"
                text="Switch .res/.resi"
                description="Switch between .res and .resi files">
            <keyboard-shortcut first-keystroke="alt O" keymap="$default"/>
            <add-to-group group-id="GoToMenu" anchor="last"/>
        </action>
        <action id="ReScript.NewFile"
                class="com.rescript.plugin.template.RescriptCreateFileAction"
                text="ReScript File"
                description="Create a new ReScript file">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
