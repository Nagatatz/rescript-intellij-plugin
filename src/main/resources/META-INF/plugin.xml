<idea-plugin>
    <id>com.rescript.plugin</id>
    <name>ReScript</name>
    <vendor url="https://github.com/ngtz/rescript-intellij-plugin">Nagatatz</vendor>

    <description><![CDATA[
        <h2>ReScript Language Support for IntelliJ IDEA</h2>
        <p>Full language support for <a href="https://rescript-lang.org">ReScript</a> (.res, .resi files).</p>

        <h3>Features</h3>
        <ul>
            <li>Syntax highlighting</li>
            <li>Code completion (via LSP)</li>
            <li>Go to definition (via LSP)</li>
            <li>Hover documentation (via LSP)</li>
            <li>Find references (via LSP)</li>
            <li>Diagnostics / error highlighting (via LSP)</li>
            <li>Inlay hints (via LSP)</li>
            <li>Code folding</li>
            <li>Brace matching</li>
            <li>Line and block comments</li>
        </ul>

        <h3>Requirements</h3>
        <ul>
            <li>Node.js installed and available in PATH</li>
            <li><code>@rescript/language-server</code> installed in project or globally</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.1.0</h3>
        <ul>
            <li>Initial release</li>
            <li>Syntax highlighting with JFlex lexer</li>
            <li>Full LSP integration (completion, diagnostics, navigation)</li>
            <li>140+ IDE integration features</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.spellchecker</depends>
    <depends optional="true" config-file="rescript-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="rescript-js-injection.xml">JavaScript</depends>
    <depends optional="true" config-file="rescript-markdown.xml">org.intellij.plugins.markdown</depends>
    <depends optional="true" config-file="rescript-debug.xml">JavaScriptDebugger</depends>
    <depends optional="true" config-file="rescript-nodejs.xml">NodeJS</depends>
    <depends optional="true" config-file="rescript-grazie.xml">tanvd.grazi</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- File types -->
        <fileType name="ReScript"
                  extensions="res"
                  fieldName="INSTANCE"
                  language="ReScript"
                  implementationClass="com.rescript.plugin.RescriptFileType"/>
        <fileType name="ReScript Interface"
                  extensions="resi"
                  fieldName="INSTANCE"
                  language="ReScript"
                  implementationClass="com.rescript.plugin.RescriptInterfaceFileType"/>

        <!-- Parser -->
        <lang.parserDefinition language="ReScript"
                               implementationClass="com.rescript.plugin.lang.RescriptParserDefinition"/>

        <!-- Syntax highlighting -->
        <lang.syntaxHighlighterFactory language="ReScript"
                                       implementationClass="com.rescript.plugin.highlight.RescriptSyntaxHighlighterFactory"/>

        <!-- Brace matching -->
        <lang.braceMatcher language="ReScript"
                           implementationClass="com.rescript.plugin.highlight.RescriptBraceMatcher"/>

        <!-- Comments -->
        <lang.commenter language="ReScript"
                        implementationClass="com.rescript.plugin.commenter.RescriptCommenter"/>

        <!-- Code folding -->
        <lang.foldingBuilder language="ReScript"
                             implementationClass="com.rescript.plugin.folding.RescriptFoldingBuilder"/>

        <!-- Structure view -->
        <lang.psiStructureViewFactory language="ReScript"
                                      implementationClass="com.rescript.plugin.structure.RescriptStructureViewFactory"/>

        <!-- Color settings page -->
        <colorSettingsPage
                implementation="com.rescript.plugin.highlight.RescriptColorSettingsPage"/>

        <!-- Explicit colors for ReScript tokens (override theme defaults) -->
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/RescriptDarcula.xml"/>
        <additionalTextAttributes scheme="Dark" file="colorSchemes/RescriptDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/RescriptDefault.xml"/>
        <additionalTextAttributes scheme="Light" file="colorSchemes/RescriptDefault.xml"/>

        <!-- rescript.json icon -->
        <iconProvider
                implementation="com.rescript.plugin.config.RescriptJsonIconProvider"/>

        <!-- Run Configuration -->
        <configurationType
                implementation="com.rescript.plugin.run.RescriptRunConfigurationType"/>

        <!-- Debug Run Configuration -->
        <configurationType
                implementation="com.rescript.plugin.debug.RescriptDebugConfigurationType"/>

        <!-- Console Filter (clickable file:line links in compiler output) -->
        <consoleFilterProvider
                implementation="com.rescript.plugin.run.RescriptConsoleFilterProvider"/>

        <!-- Code style settings -->
        <langCodeStyleSettingsProvider
                implementation="com.rescript.plugin.codestyle.RescriptCodeStyleSettingsProvider"/>

        <!-- Smart quote completion -->
        <lang.quoteHandler language="ReScript"
                           implementationClass="com.rescript.plugin.editor.RescriptQuoteHandler"/>

        <!-- Code rearranger (#52) -->
        <lang.rearranger language="ReScript"
                         implementationClass="com.rescript.plugin.codestyle.RescriptRearranger"/>

        <!-- Smart indentation on Enter -->
        <lineIndentProvider
                implementation="com.rescript.plugin.codestyle.RescriptLineIndentProvider"/>

        <!-- Breadcrumb navigation -->
        <breadcrumbsInfoProvider
                implementation="com.rescript.plugin.breadcrumb.RescriptBreadcrumbsProvider"/>

        <!-- Navigation bar structure -->
        <navbar implementation="com.rescript.plugin.navbar.RescriptStructureAwareNavbar"/>

        <!-- Refactoring support (Introduce Variable: Ctrl+Alt+V) -->
        <lang.refactoringSupport language="ReScript"
                implementationClass="com.rescript.plugin.refactor.RescriptRefactoringSupportProvider"/>

        <!-- Rename refactoring -->
        <renameHandler
                implementation="com.rescript.plugin.refactor.RescriptRenameHandler"/>
        <lang.namesValidator language="ReScript"
                             implementationClass="com.rescript.plugin.refactor.RescriptNamesValidator"/>

        <!-- Project settings -->
        <projectConfigurable
                parentId="language"
                instance="com.rescript.plugin.settings.RescriptConfigurable"
                id="com.rescript.plugin.settings"
                displayName="ReScript"/>
        <projectService
                serviceImplementation="com.rescript.plugin.settings.RescriptProjectSettings"/>

        <!-- LSP (completion, diagnostics, navigation, hover, etc.) -->
        <platform.lsp.serverSupportProvider
                implementation="com.rescript.plugin.lsp.RescriptLspServerSupportProvider"/>

        <!-- Compilation status service (receives LSP notifications) -->
        <projectService
                serviceImplementation="com.rescript.plugin.lsp.RescriptCompilationStatusService"/>

        <!-- Build status widget in status bar -->
        <statusBarWidgetFactory id="RescriptCompilerStatus"
                implementation="com.rescript.plugin.statusbar.RescriptCompilerStatusWidgetFactory"/>

        <!-- Stub element type holder for PSI stub indexing -->
        <stubElementTypeHolder class="com.rescript.plugin.lang.psi.RescriptStubElementTypes"/>

        <!-- Stub indexes for fast symbol lookup -->
        <stubIndex implementation="com.rescript.plugin.indexing.RescriptNameIndex"/>
        <stubIndex implementation="com.rescript.plugin.indexing.RescriptModuleIndex"/>

        <!-- TODO indexer -->
        <todoIndexer filetype="ReScript"
                     implementationClass="com.rescript.plugin.indexing.RescriptTodoIndexer"/>
        <todoIndexer filetype="ReScript Interface"
                     implementationClass="com.rescript.plugin.indexing.RescriptTodoIndexer"/>

        <!-- Index Pattern Builder (TODO/FIXME in comments) (#61) -->
        <indexPatternBuilder
                implementation="com.rescript.plugin.indexing.RescriptIndexPatternBuilder"/>

        <!-- Go to Symbol -->
        <gotoSymbolContributor
                implementation="com.rescript.plugin.navigation.RescriptSymbolContributor"/>

        <!-- Go to Related (.res/.resi/.js) -->
        <gotoRelatedProvider
                implementation="com.rescript.plugin.navigation.RescriptGotoRelatedProvider"/>

        <!-- Code formatting (rescript format CLI) -->
        <formattingService
                implementation="com.rescript.plugin.formatter.RescriptFormattingService"/>

        <!-- Formatting model for injected language support (#55) -->
        <lang.formatter language="ReScript"
                        implementationClass="com.rescript.plugin.formatter.RescriptInjectedFormattingModelBuilder"/>

        <!-- Live Templates -->
        <defaultLiveTemplates>/liveTemplates/ReScript</defaultLiveTemplates>

        <!-- Inspections -->
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptDuplicateOpen"
                         displayName="Duplicate open statement"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptDuplicateOpenInspection"/>
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptEmptyModule"
                         displayName="Empty module declaration"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptEmptyModuleInspection"/>
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptMissingConfig"
                         displayName="Missing rescript.json configuration"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptMissingConfigInspection"/>

        <!-- File Templates -->
        <internalFileTemplate name="ReScript Module"/>
        <internalFileTemplate name="ReScript Interface"/>
        <internalFileTemplate name="ReScript Component"/>

        <!-- Spell checking -->
        <spellchecker.support language="ReScript"
                              implementationClass="com.rescript.plugin.spellcheck.RescriptSpellcheckingStrategy"/>

        <!-- Postfix Completion -->
        <codeInsight.template.postfixTemplateProvider language="ReScript"
                                                      implementationClass="com.rescript.plugin.completion.RescriptPostfixTemplateProvider"/>

        <!-- Notification group for ReScript balloon notifications -->
        <notificationGroup id="ReScript" displayType="BALLOON"/>

        <!-- Editor notification (LSP not found) -->
        <editorNotificationProvider
                implementation="com.rescript.plugin.editor.RescriptEditorNotificationProvider"/>

        <!-- Startup activity: prompt LSP installation for ReScript projects -->
        <postStartupActivity
                implementation="com.rescript.plugin.lsp.RescriptLspStartupActivity"/>

        <!-- AST factory for language injection support in string literals -->
        <lang.ast.factory language="ReScript"
                          implementationClass="com.rescript.plugin.lang.RescriptAstFactory"/>

        <!-- Import Optimizer (remove duplicate open statements) -->
        <lang.importOptimizer language="ReScript"
                              implementationClass="com.rescript.plugin.imports.RescriptImportOptimizer"/>

        <!-- Code Vision (Code Lens via LSP) -->
        <codeInsight.daemonBoundCodeVisionProvider
                implementation="com.rescript.plugin.codevision.RescriptCodeVisionProvider"/>

        <!-- Intention Actions -->
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptWrapWithSomeIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptWrapWithOkIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptWrapWithErrorIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptAddGenTypeIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptGenerateDocCommentIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptAddIgnoreIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptAddUnderscorePrefixIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptRemoveRedundantBracesIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptFixIdentifierCaseIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptConvertPipeToFunctionCallIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptConvertFunctionCallToPipeIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptAddToInterfaceIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptRemoveFromInterfaceIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>

        <!-- Decorator/Attribute Completion -->
        <completion.contributor language="ReScript"
                                implementationClass="com.rescript.plugin.completion.RescriptDecoratorCompletionContributor"/>

        <!-- Surround With -->
        <lang.surroundDescriptor language="ReScript"
                                 implementationClass="com.rescript.plugin.surround.RescriptSurroundDescriptor"/>

        <!-- Gutter run icon for ReScript files -->
        <runLineMarkerContributor language="ReScript"
                                   implementationClass="com.rescript.plugin.run.RescriptRunLineMarkerContributor"/>

        <!-- reanalyze integration (dead code / exception analysis) -->
        <externalAnnotator language="ReScript"
                           implementationClass="com.rescript.plugin.analysis.RescriptReanalyzeAnnotator"/>

        <!-- Format check (highlights unformatted code) -->
        <externalAnnotator language="ReScript"
                           implementationClass="com.rescript.plugin.analysis.RescriptFormatCheckAnnotator"/>

        <!-- Custom folding regions (//#region ... //#endregion) -->
        <customFoldingProvider
                implementation="com.rescript.plugin.folding.RescriptCustomFoldingProvider"/>

        <!-- Statement Up/Down Mover (Alt+Shift+Up/Down) -->
        <statementUpDownMover
                implementation="com.rescript.plugin.editor.RescriptStatementUpDownMover"/>

        <!-- Qualified Name Copy (Cmd+Shift+Alt+C) -->
        <qualifiedNameProvider
                implementation="com.rescript.plugin.navigation.RescriptQualifiedNameProvider"/>

        <!-- Element Signature Provider (fold state persistence) (#60) -->
        <elementSignatureProvider
                implementation="com.rescript.plugin.navigation.RescriptElementSignatureProvider"/>

        <!-- Smart Enter (Shift+Enter) -->
        <lang.smartEnterProcessor language="ReScript"
                                   implementationClass="com.rescript.plugin.editor.RescriptSmartEnterProcessor"/>

        <!-- Test Runner -->
        <configurationType
                implementation="com.rescript.plugin.test.RescriptTestRunConfigurationType"/>
        <runConfigurationProducer
                implementation="com.rescript.plugin.test.RescriptTestConfigurationProducer"/>

        <!-- Compiled JS Preview Tool Window -->
        <toolWindow id="ReScript JS" anchor="right" icon="AllIcons.FileTypes.JavaScript"
                    factoryClass="com.rescript.plugin.preview.RescriptCompiledJsPreviewToolWindowFactory"/>

        <!-- Type Info Tool Window (always-visible type display at caret) -->
        <toolWindow id="ReScript Type" anchor="bottom" secondary="true"
                    factoryClass="com.rescript.plugin.typeinfo.RescriptTypeInfoToolWindowFactory"
                    icon="/icons/rescript-file.svg"/>

        <!-- Unused Code Detection (via reanalyze) -->
        <globalInspection language="ReScript" groupName="ReScript" shortName="RescriptUnusedCode"
                          displayName="Unused code (via reanalyze)" enabledByDefault="true" level="WARNING"
                          implementationClass="com.rescript.plugin.analysis.RescriptUnusedCodeInspection"/>

        <!-- Module Hierarchy -->
        <hierarchyProvider language="ReScript"
                           implementationClass="com.rescript.plugin.hierarchy.RescriptModuleHierarchyProvider"/>

        <!-- Call Hierarchy -->
        <callHierarchyProvider language="ReScript"
                               implementationClass="com.rescript.plugin.hierarchy.call.RescriptCallHierarchyProvider"/>

        <!-- Project Wizard -->
        <moduleBuilder builderClass="com.rescript.plugin.wizard.RescriptModuleBuilder"
                       id="RESCRIPT_MODULE"
                       order="last"/>

        <!-- Error Lens (inline diagnostic display) -->
        <editorFactoryListener
                implementation="com.rescript.plugin.errorlens.RescriptErrorLensEditorListener"/>

        <!-- Bundled dictionary for ReScript-specific terms -->
        <spellchecker.bundledDictionaryProvider
                implementation="com.rescript.plugin.spellcheck.RescriptBundledDictionaryProvider"/>

        <!-- Test source filter (recognize *_test.res, __tests__/) -->
        <testSourcesFilter
                implementation="com.rescript.plugin.test.RescriptTestSourcesFilter"/>

        <!-- Context Info (sticky declaration header on scroll) -->
        <declarationRangeHandler key="com.rescript.plugin.lang.psi.RescriptElementType"
                implementationClass="com.rescript.plugin.editor.RescriptDeclarationRangeHandler"/>

        <!-- Find Usages provider -->
        <lang.findUsagesProvider language="ReScript"
                implementationClass="com.rescript.plugin.lang.RescriptFindUsagesProvider"/>

        <!-- Unwrap/Remove (Ctrl+Shift+Delete) -->
        <lang.unwrapDescriptor language="ReScript"
                implementationClass="com.rescript.plugin.editor.RescriptUnwrapDescriptor"/>

        <!-- JSX auto-close tag on '>' -->
        <typedHandler
                implementation="com.rescript.plugin.editor.RescriptTypedHandler"/>

        <!-- Go to Test / Create Test (Ctrl+Shift+T) -->
        <testCreator language="ReScript"
                implementation="com.rescript.plugin.navigation.RescriptTestCreator"/>

        <!-- Project View: nest .resi under .res -->
        <treeStructureProvider
                implementation="com.rescript.plugin.projectview.RescriptTreeStructureProvider"/>

        <!-- Project View: nest .res.js under .res -->
        <projectViewNestingRulesProvider
                implementation="com.rescript.plugin.projectview.RescriptFileNestingProvider"/>

        <!-- Project View: gray out compiled .res.js files -->
        <projectViewNodeDecorator
                implementation="com.rescript.plugin.projectview.RescriptCompiledJsNodeDecorator"/>

        <!-- Completion Confidence (suppress auto-popup in comments/strings) -->
        <completion.confidence language="ReScript"
                               implementationClass="com.rescript.plugin.completion.RescriptCompletionConfidence"/>

        <!-- Live Template Context -->
        <liveTemplateContext
                implementation="com.rescript.plugin.completion.RescriptTemplateContextType"/>

        <!-- Live Template Macros -->
        <liveTemplateMacro
                implementation="com.rescript.plugin.completion.RescriptModuleNameMacro"/>
        <liveTemplateMacro
                implementation="com.rescript.plugin.completion.RescriptComponentNameMacro"/>

        <!-- Problem Highlight Filter (suppress diagnostics in node_modules/lib) -->
        <problemHighlightFilter
                implementation="com.rescript.plugin.analysis.RescriptProblemHighlightFilter"/>

        <!-- Enter Handler (doc comment continuation) -->
        <enterHandlerDelegate
                implementation="com.rescript.plugin.editor.RescriptEnterHandler"/>

        <!-- Join Lines (smart line joining) -->
        <joinLinesHandler
                implementation="com.rescript.plugin.editor.RescriptJoinLinesHandler"/>

        <!-- Extend/Shrink Word Selection -->
        <extendWordSelectionHandler
                implementation="com.rescript.plugin.editor.RescriptStringSelectionHandler"/>
        <extendWordSelectionHandler
                implementation="com.rescript.plugin.editor.RescriptBracketSelectionHandler"/>
        <extendWordSelectionHandler
                implementation="com.rescript.plugin.editor.RescriptCommentSelectionHandler"/>

        <!-- Highlight Usages (keyword-based: switch/if/try/pipe) -->
        <highlightUsagesHandlerFactory
                implementation="com.rescript.plugin.highlight.RescriptHighlightUsagesHandlerFactory"/>

        <!-- Goto Super (.res -> .resi declaration jump) -->
        <codeInsight.gotoSuper language="ReScript"
                                implementationClass="com.rescript.plugin.navigation.RescriptGotoSuperHandler"/>

        <!-- Documentation Provider (Quick Doc + External Docs) -->
        <lang.documentationProvider language="ReScript"
                                     implementationClass="com.rescript.plugin.documentation.RescriptDocumentationProvider"/>

        <!-- Run Anything Provider (rescript build/clean/format) -->
        <runAnythingProvider
                implementation="com.rescript.plugin.run.RescriptRunAnythingProvider"/>

        <!-- Expression Type Info (Ctrl+Shift+P via LSP hover) -->
        <codeInsight.expressionTypeProvider language="ReScript"
                                             implementationClass="com.rescript.plugin.lsp.RescriptExpressionTypeProvider"/>

        <!-- Predefined code style ("ReScript Standard" preset) -->
        <predefinedCodeStyle
                implementation="com.rescript.plugin.codestyle.RescriptPredefinedCodeStyle"/>

        <!-- Element descriptions for refactoring dialogs and Find Usages -->
        <elementDescriptionProvider
                implementation="com.rescript.plugin.lang.RescriptElementDescriptionProvider"/>

        <!-- Reader mode for node_modules .res/.resi files -->
        <readerModeMatcher
                implementation="com.rescript.plugin.editor.RescriptReaderModeMatcher"/>

        <!-- Lookup character filter for completion behavior -->
        <lookup.charFilter
                implementation="com.rescript.plugin.completion.RescriptLookupCharFilter"/>

        <!-- Inspection suppression via // noinspection comments -->
        <lang.inspectionSuppressor language="ReScript"
                implementationClass="com.rescript.plugin.inspection.RescriptInspectionSuppressor"/>

        <!-- Backspace handler (JSX tag pair deletion) -->
        <backspaceHandlerDelegate
                implementation="com.rescript.plugin.editor.RescriptBackspaceHandler"/>

        <!-- Color preview swatches in editor gutter -->
        <colorProvider
                implementation="com.rescript.plugin.editor.RescriptColorProvider"/>

        <!-- VCS Code Vision (author/last-change annotations on declarations) -->
        <vcs.codeVisionLanguageContext language="ReScript"
                implementationClass="com.rescript.plugin.codevision.RescriptVcsCodeVisionContext"/>

        <!-- Project View: "has interface" suffix and rescript.json version -->
        <projectViewNodeDecorator
                implementation="com.rescript.plugin.projectview.RescriptProjectViewNodeDecorator"/>

        <!-- String escape on paste into string literals -->
        <copyPastePreProcessor
                implementation="com.rescript.plugin.editor.RescriptCopyPastePreProcessor"/>

        <!-- File Include Provider (open statement → file navigation) (#68) -->
        <include.provider
                implementation="com.rescript.plugin.navigation.RescriptFileIncludeProvider"/>

        <!-- Index of open statements for fast module lookup -->
        <fileBasedIndex
                implementation="com.rescript.plugin.indexing.RescriptOpenStatementIndex"/>

        <!-- HTML to ReScript JSX conversion on paste -->
        <copyPastePostProcessor
                implementation="com.rescript.plugin.paste.RescriptPasteAsJsxProcessor"/>

        <!-- Package Dependencies Tool Window (rescript.json) -->
        <toolWindow id="ReScript Dependencies" anchor="right" icon="AllIcons.Nodes.PpLib"
                factoryClass="com.rescript.plugin.dependencies.RescriptDependenciesToolWindowFactory"/>

        <!-- Auto Import options in Settings > Editor > General > Auto Import -->
        <autoImportOptionsProvider
                instance="com.rescript.plugin.imports.RescriptAutoImportOptionsProvider"/>

        <!-- Move Element Left/Right (Alt+Shift+Cmd+Left/Right) -->
        <moveLeftRightHandler language="ReScript"
                implementationClass="com.rescript.plugin.editor.RescriptMoveElementHandler"/>

        <!-- Usage type classification for Find Usages grouping -->
        <usageTypeProvider
                implementation="com.rescript.plugin.lang.RescriptUsageTypeProvider"/>

        <!-- Code block boundary detection (Ctrl+Shift+[ / ]) -->
        <codeBlockProvider language="ReScript"
                implementationClass="com.rescript.plugin.editor.RescriptCodeBlockHandler"/>

        <!-- Split/Join List (1-line ↔ multi-line) -->
        <listSplitJoinContext
                implementation="com.rescript.plugin.editor.RescriptListSplitJoinContext"/>

        <!-- Strip trailing spaces filter (protect strings) (#53) -->
        <stripTrailingSpacesFilterFactory
                implementation="com.rescript.plugin.editor.RescriptStripTrailingSpacesFilterFactory"/>

        <!-- Editor floating toolbar for ReScript files (#69) -->
        <editorFloatingToolbarProvider
                implementation="com.rescript.plugin.editor.RescriptFloatingToolbarProvider"
                order="last"/>

        <!-- Safe Delete with usage check (Refactor > Safe Delete) -->
        <refactoring.safeDeleteProcessor
                implementation="com.rescript.plugin.refactor.RescriptSafeDeleteProcessor"/>

        <!-- Name suggestions during rename refactoring -->
        <nameSuggestionProvider
                implementation="com.rescript.plugin.refactor.RescriptNameSuggestionProvider"/>

        <!-- Error report handler (opens GitHub issue in browser) -->
        <errorHandler
                implementation="com.rescript.plugin.RescriptErrorReporter"/>

        <!-- Search Everywhere contributor for ReScript symbols (#46) -->
        <searchEverywhereContributor
                implementation="com.rescript.plugin.navigation.RescriptSearchEverywhereContributor$Factory"/>

        <!-- Completion Weigher for ReScript (#50) -->
        <completion.weigher language="ReScript" id="rescriptWeigher"
                implementationClass="com.rescript.plugin.completion.RescriptCompletionWeigher"/>

        <!-- Pipe chain intermediate type inlay hints (#74) -->
        <codeInsight.inlayHintsProvider language="ReScript"
                implementationClass="com.rescript.plugin.lsp.RescriptPipeChainTypeHintsProvider"/>

        <!-- Mutability diagnostics (#103) -->
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptMutability"
                         displayName="Unnecessary mutable ref"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptMutabilityInspection"/>

        <!-- Style linting (#102) -->
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptStyleLint"
                         displayName="ReScript style improvements"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptStyleLintInspection"/>

        <!-- PPX annotation visualization (#109) -->
        <codeInsight.inlayHintsProvider language="ReScript"
                implementationClass="com.rescript.plugin.lsp.RescriptPpxVisualizationProvider"/>

        <!-- Signature sync inspection (#94) -->
        <localInspection language="ReScript"
                         groupName="ReScript"
                         shortName="RescriptSignatureSync"
                         displayName="Interface file out of sync"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.rescript.plugin.inspection.RescriptSignatureSyncInspection"/>

        <!-- Intention: Insert labeled arguments (#75) -->
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptInsertLabeledArgsIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>

        <!-- Intention: Merge switch cases (#78) -->
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
            <className>com.rescript.plugin.intention.RescriptMergeSwitchCasesIntention</className>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>

        <!-- Intention: Split into constructor cases (#95) -->
        <intentionAction>
            <language>ReScript</language>
            <category>ReScript</category>
