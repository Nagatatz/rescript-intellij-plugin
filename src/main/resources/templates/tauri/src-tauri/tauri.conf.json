{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{projectName}}",
  "version": "0.0.0",
  "identifier": "com.example.{{projectName}}",
  "build": {
    "beforeDevCommand": "{{cmdRunDev}}",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "{{cmdBuild}}",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "{{projectName}}",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
