{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the local renderer window: core IPC + plugins exercised in the sample.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-title",
    "core:window:allow-inner-size",
    "core:window:allow-theme",
    "core:path:default",
    "os:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:scope-home",
    "fs:scope-document",
    "fs:scope-desktop",
    "fs:scope-download",
    "fs:scope-temp",
    "fs:scope-appdata",
    "fs:scope-applog",
    "dialog:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "log:default"
  ]
}
