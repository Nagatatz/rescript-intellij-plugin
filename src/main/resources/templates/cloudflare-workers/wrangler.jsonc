{
  // Workers KV binding. Replace the placeholder id after running:
  //   npx wrangler kv namespace create GREETINGS
  "name": "{{projectName}}",
  "main": "src/Server.res.mjs",
  "compatibility_date": "2024-01-01",
  "kv_namespaces": [
    { "binding": "GREETINGS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}