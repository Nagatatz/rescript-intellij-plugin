<templateSet group="ReScript">
    <template name="let"
              value="let $NAME$ = $VALUE$$END$"
              description="let binding"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="name" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="value" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="letfn"
              value="let $NAME$ = ($PARAMS$) => {&#10;  $END$&#10;}"
              description="let function definition"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="name" alwaysStopAt="true"/>
        <variable name="PARAMS" expression="" defaultValue="params" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="mod"
              value="module $NAME$ = {&#10;  $END$&#10;}"
              description="module definition"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="Name" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="modt"
              value="module type $NAME$ = {&#10;  $END$&#10;}"
              description="module type definition"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="Name" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="typ"
              value="type $NAME$ = $END$"
              description="type definition"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="name" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="typv"
              value="type $NAME$ =&#10;  | $VARIANT$$END$"
              description="variant type definition"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="name" alwaysStopAt="true"/>
        <variable name="VARIANT" expression="" defaultValue="Variant" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="typr"
              value="type $NAME$ = {&#10;  $FIELD$: $TYPE$,&#10;  $END$&#10;}"
              description="record type definition"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="name" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="field" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="string" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="ext"
              value="external $NAME$: $TYPE$ = &quot;$JS_NAME$&quot;"
              description="external declaration (FFI)"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="name" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="'a" alwaysStopAt="true"/>
        <variable name="JS_NAME" expression="" defaultValue="jsName" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="sw"
              value="switch $EXPR$ {&#10;| $PATTERN$ => $END$&#10;}"
              description="switch expression"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="EXPR" expression="" defaultValue="expr" alwaysStopAt="true"/>
        <variable name="PATTERN" expression="" defaultValue="pattern" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="try"
              value="try {&#10;  $END$&#10;} catch {&#10;| $EXN$ => $HANDLER$&#10;}"
              description="try-catch expression"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="EXN" expression="" defaultValue="exn" alwaysStopAt="true"/>
        <variable name="HANDLER" expression="" defaultValue="()" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="for"
              value="for $VAR$ in $START$ to $FINISH$ {&#10;  $BODY$$END$&#10;}"
              description="for loop"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="VAR" expression="" defaultValue="i" alwaysStopAt="true"/>
        <variable name="START" expression="" defaultValue="0" alwaysStopAt="true"/>
        <variable name="FINISH" expression="" defaultValue="10" alwaysStopAt="true"/>
        <variable name="BODY" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="if"
              value="if $COND$ {&#10;  $END$&#10;}"
              description="if expression"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="COND" expression="" defaultValue="condition" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="ife"
              value="if $COND$ {&#10;  $THEN$&#10;} else {&#10;  $END$&#10;}"
              description="if-else expression"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="COND" expression="" defaultValue="condition" alwaysStopAt="true"/>
        <variable name="THEN" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="pipe"
              value="-&gt;$FUNC$($END$)"
              description="pipe operator"
              toReformat="true"
              toShortenFQNames="false">
        <variable name="FUNC" expression="" defaultValue="func" alwaysStopAt="true"/>
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>

    <template name="log"
              value="Console.log($END$)"
              description="Console.log"
              toReformat="true"
              toShortenFQNames="false">
        <context>
            <option name="RESCRIPT" value="true"/>
        </context>
    </template>
</templateSet>
