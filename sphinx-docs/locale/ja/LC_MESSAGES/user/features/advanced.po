#: ../../user/features/advanced.md:694
msgid "Conditional types and mapped types"
msgstr "条件型とマップ型"

#: ../../user/features/advanced.md:695
msgid "Template literal types"
msgstr "テンプレートリテラル型"

#: ../../user/features/advanced.md:696
msgid "Complex generics with constraints"
msgstr "制約付きの複雑なジェネリクス"

#: ../../user/features/advanced.md:697
msgid "Intersection types (generates `JSON.t` fallback)"
msgstr "交差型（`JSON.t` にフォールバック）"

#: ../../user/features/advanced.md:698
