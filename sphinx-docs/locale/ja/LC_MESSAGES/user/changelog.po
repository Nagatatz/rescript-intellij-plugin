#: ../../user/changelog.md:1
msgid "Changelog"
msgstr "変更履歴"

#: ../../user/changelog.md:3
msgid "0.1.6"
msgstr "0.1.6"

#: ../../user/changelog.md:5 ../../user/changelog.md:30
msgid "Bug Fixes"
msgstr "バグ修正"

#: ../../user/changelog.md:7
msgid ""
"Fix EDT threading violation in TypeInfoPanel when accessing caret offset "
"from pooled thread"
msgstr ""
"TypeInfoPanel でプールスレッドからキャレットオフセットにアクセスする際の EDT スレッド違反を修正"

#: ../../user/changelog.md:8
msgid ""
"Fix GenerateGroup to extend DefaultActionGroup for proper child action "
"support"
msgstr ""
"GenerateGroup が DefaultActionGroup を継承するよう修正し、子アクションを正しくサポート"

#: ../../user/changelog.md:9
msgid ""
"Fix testCreator extension point attribute name (`implementation` → "
"`implementationClass`)"
msgstr ""
"testCreator Extension Point の属性名を修正（`implementation` → `implementationClass`）"

#: ../../user/changelog.md:11
msgid "0.1.5"
msgstr "0.1.5"

#: ../../user/changelog.md:13 ../../user/changelog.md:35
msgid "Refactoring"
msgstr "リファクタリング"

#: ../../user/changelog.md:15
msgid "Migrate test suite from JUnit 4 to JUnit 5 (Jupiter)"
msgstr "テストスイートを JUnit 4 から JUnit 5 (Jupiter) に移行"

#: ../../user/changelog.md:16
msgid "Centralize regex patterns into RescriptRegexPatterns"
msgstr "正規表現パターンを RescriptRegexPatterns に集約"

#: ../../user/changelog.md:17
msgid "Extract brace balance utilities into RescriptBraceBalanceUtil"
msgstr "括弧バランスユーティリティを RescriptBraceBalanceUtil に抽出"

#: ../../user/changelog.md:18
msgid ""
"Extract common patterns: quick fix in StyleLintInspection, Gson "
"deserialization, region search in UnwrapDescriptor"
msgstr ""
"共通パターンの抽出: StyleLintInspection の Quick Fix、Gson デシリアライゼーション、UnwrapDescriptor のリージョン検索"

#: ../../user/changelog.md:19
msgid "Reduce postfix template boilerplate with data-driven approach"
msgstr "データ駆動アプローチにより Postfix テンプレートのボイラープレートを削減"

#: ../../user/changelog.md:20
msgid ""
"Remove redundant Elvis operator, duplicate type wrappers, unnecessary "
"companion object shims"
msgstr ""
"冗長な Elvis 演算子、重複する型ラッパー、不要な companion object シムを削除"

#: ../../user/changelog.md:21
msgid ""
"Replace inline regex with string matching in SignatureSyncInspection and "
"isModuleOpened"
msgstr ""
"SignatureSyncInspection と isModuleOpened でインライン正規表現を文字列マッチングに置換"

#: ../../user/changelog.md:23 ../../user/changelog.md:39
msgid "Infrastructure"
msgstr "インフラ"

#: ../../user/changelog.md:25
msgid "Remove unused LOG fields in DtsNodeDetector and RescriptReplExecutor"
msgstr "DtsNodeDetector と RescriptReplExecutor の未使用 LOG フィールドを削除"

#: ../../user/changelog.md:26
msgid "Restore Kover coverage verification above 54% threshold"
msgstr "Kover カバレッジ検証の 54% 閾値を復元"

#: ../../user/changelog.md:28
msgid "0.1.4"
msgstr "0.1.4"

#: ../../user/changelog.md:32
msgid "Rewrite CodeVisionProvider in Java to avoid internal API reference"
msgstr "内部 API 参照を回避するため CodeVisionProvider を Java で書き直し"

#: ../../user/changelog.md:33
msgid "Add exception logging and fix InterruptedException handling"
msgstr "例外ログの追加と InterruptedException 処理の修正"

#: ../../user/changelog.md:37
msgid "Extract RescriptProcessUtils for shared process execution"
msgstr "共通プロセス実行のため RescriptProcessUtils を抽出"

#: ../../user/changelog.md:41
msgid "Optimize CI by merging verify job and reordering Kover tasks"
msgstr "verify ジョブの統合と Kover タスクの並べ替えにより CI を最適化"

#: ../../user/changelog.md:42
msgid "Add Kover exclusions and unit tests for coverage improvement"
msgstr "カバレッジ向上のため Kover 除外設定とユニットテストを追加"

#: ../../user/changelog.md:43
msgid ""
"Add medium-difficulty tests for StringLiteral, DtsParserProcess, and "
"GenerateActionUtil"
msgstr ""
"StringLiteral、DtsParserProcess、GenerateActionUtil の中難度テストを追加"

#: ../../user/changelog.md:44
msgid "Expand plugin description and fix changelog versioning"
msgstr "プラグインの説明を拡充し、変更履歴のバージョニングを修正"

#: ../../user/changelog.md:46
msgid "0.1.3"
msgstr "0.1.3"

#: ../../user/changelog.md:48
msgid "Improvements"
msgstr "改善"

#: ../../user/changelog.md:50
msgid "Add plugin icon for JetBrains Marketplace display"
msgstr "JetBrains Marketplace 表示用のプラグインアイコンを追加"

#: ../../user/changelog.md:51
msgid "Fix plugin verifier deprecated API warnings"
msgstr "Plugin Verifier の非推奨 API 警告を修正"

#: ../../user/changelog.md:52
msgid "Update docs to reflect current implementation state"
msgstr "現在の実装状態を反映するようドキュメントを更新"

#: ../../user/changelog.md:54
msgid "0.1.2"
msgstr "0.1.2"

#: ../../user/changelog.md:56
msgid "Features"
msgstr "機能"

