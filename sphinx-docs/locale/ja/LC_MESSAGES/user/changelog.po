#: ../../user/changelog.md:1
msgid "Changelog"
msgstr "変更履歴"

#: ../../user/changelog.md:3
msgid "Unreleased"
msgstr "未リリース"

#: ../../user/changelog.md:5
msgid "Initial release of the ReScript IntelliJ Plugin."
msgstr "ReScript IntelliJ Plugin の初回リリースです。"

#: ../../user/changelog.md:7
msgid "Features"
msgstr "機能"

#: ../../user/changelog.md:9
msgid "Full syntax highlighting via JFlex lexer"
msgstr "JFlex レクサーによる完全なシンタックスハイライト"

#: ../../user/changelog.md:10
msgid "LSP integration with `@rescript/language-server`"
msgstr "`@rescript/language-server` との LSP 統合"

#: ../../user/changelog.md:11
msgid "Semantic highlighting via LSP semantic tokens"
msgstr "LSP セマンティックトークンによるセマンティックハイライト"

#: ../../user/changelog.md:12
msgid "Code completion, Go to Definition, Hover, Find Usages"
msgstr "コード補完、定義へ移動、ホバー、使用箇所の検索"

#: ../../user/changelog.md:13
msgid "Code folding (modules, declarations, comments, custom regions)"
msgstr "コード折りたたみ（モジュール、宣言、コメント、カスタムリージョン）"

#: ../../user/changelog.md:14
msgid "Brace matching and smart quotes"
msgstr "括弧の対応付けとスマート引用符"

